{
  "name": "astro-prefetch-ai-brief",
  "version": "0.1.0",
  "description": "Astro integration that enhances prefetch by generating predictive, ultra-compact 15-word floating previews on link hover using Chrome Built-in AI Summarizer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/client.ts --outdir ./dist && bun x tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "prefetch",
    "chrome-ai",
    "summarizer",
    "gemini-nano",
    "preview",
    "tooltip",
    "built-in-ai"
  ],
  "author": "bhubbard",
  "license": "MIT",
  "peerDependencies": {
    "astro": ">=5.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^5.4.0",
    "typescript": "^5.8.0"
  }
}
